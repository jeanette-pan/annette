generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StatusEntry {
  id        String    @id @default(cuid())
  userId    String
  userName  String
  status    String
  emoji     String    @default("✨")
  color     String    @default("#e9d5ff")
  note      String?
  isShared  Boolean   @default(false)
  startTime DateTime  @default(now())
  endTime   DateTime?
  date      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model StatusTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  status    String
  emoji     String   @default("✨")
  color     String   @default("#e9d5ff")
  note      String?
  isShared  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmotionEntry {
  id        String   @id @default(cuid())
  userId    String
  emotion   String
  startTime DateTime @default(now())

  @@index([userId, startTime])
}

model BugReport {
  id        String   @id @default(cuid())
  type      String   @default("bug") // "bug" | "suggestion"
  title     String
  body      String?
  priority  String   @default("medium") // "low" | "medium" | "high"
  status    String   @default("open") // "open" | "done"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CalendarEvent {
  id        String   @id @default(cuid())
  title     String
  date      String   // YYYY-MM-DD
  startTime String?  // HH:MM (24h)
  endTime   String?  // HH:MM (24h)
  note      String?
  color     String   @default("#d1fae5")
  eventType String   @default("event")
  isShared  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
